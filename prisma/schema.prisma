// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── User & Auth ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  passwordHash  String?
  name          String
  role          String    @default("customer") // customer | business_owner | admin | moderator
  phone         String?
  whatsapp      String?
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  reviews       Review[]
  rfqs          RFQ[]
  forumThreads  ForumThread[]
  forumReplies  ForumReply[]
  orders        Order[]
  sessions      Session[]
  accounts      Account[]
  cart          Cart?
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Business / Supplier ──────────────────────────────────────────────────────

model Business {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId         String?  @db.ObjectId  // links to User.id (seller who registered)
  name            String
  legalName       String
  description     String
  logo            String?
  banner          String?
  businessTypes   String   // JSON array: ["manufacturer","distributor"]
  gst             String   @unique
  pan             String   @default("")
  msme            Boolean  @default(false)
  yearEstablished Int      @default(2024)
  employees       Int?
  annualRevenue   String?
  website         String?
  email           String
  phone           String
  whatsapp        String?
  linkedIn        String?

  // Address (stored as JSON string)
  address         String   // JSON object
  factoryAddress  String?  // JSON object

  certifications  String   @default("{}")   // JSON object: {iso,rohs,bis,ce,iec}
  gallery         String?  // JSON array of URLs
  badges          String   @default("{}")   // JSON object: {verified,topRated,fastDelivery,...}
  stats           String   @default("{}")   // JSON object: {responseRate,avgDeliveryTime,...}
  rating          Float    @default(0)
  status          String   @default("pending") // pending | approved | rejected

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  products        Product[]
  reviews         Review[]
}

// ─── Product Catalog ──────────────────────────────────────────────────────────

model Product {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  category              String
  subcategory           String?
  brand                 String
  manufacturer          String
  manufacturerPartNumber String
  supplierPartNumber    String
  description           String
  images                String   // JSON array of URLs
  videos                String?  // JSON array
  datasheet             String?

  supplierId            String   @db.ObjectId
  supplier              Business @relation(fields: [supplierId], references: [id])

  stock                 Int      @default(0)
  minOrderQuantity      Int      @default(1)
  price                 Float
  leadTime              String
  packaging             String
  countryOfOrigin       String
  hsnCode               String?
  warranty              String?
  lifecycle             String   @default("active") // active | discontinued | obsolete
  rohs                  Boolean  @default(false)
  reach                 Boolean  @default(false)

  // ── Component Specific Attributes (Optional) ──
  capacitance           String?
  voltageRating         String?
  tolerance             String?
  dielectric            String?
  esr                   String?
  rippleCurrent         String?
  temperature           String?
  caseSize              String?
  dimensions            String?
  mounting              String?
  termination           String?
  resistance            String?
  powerRating           String?
  tempCoefficient       String?
  technology            String?

  specs                 String?  // JSON object — other category-specific specs
  filterAttributes      String?  @default("{}") // JSON object — filter values used by search filters

  rating                Float?
  reviewCount           Int      @default(0)
  likes                 Int      @default(0)
  status                String   @default("pending") // pending | approved | rejected

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  reviews               Review[]
  orderItems            OrderItem[]
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   String?  @db.ObjectId
  supplierId  String?  @db.ObjectId
  userId      String   @db.ObjectId
  userName    String
  rating      Int
  title       String
  content     String
  images      String?  // JSON array
  videos      String?  // JSON array
  verified    Boolean  @default(false)
  helpful     Int      @default(0)
  unhelpful   Int      @default(0)
  categories  String?  // JSON object: {quality, originality, packaging, price, delivery, support}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product?  @relation(fields: [productId], references: [id])
  supplier    Business? @relation(fields: [supplierId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

// ─── RFQ System ───────────────────────────────────────────────────────────────

model RFQ {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  customerId   String      @db.ObjectId
  customerName String
  title        String
  description  String
  items        RFQItem[]
  bom          String?     // JSON object: {file?, content?}
  targetPrice  String?
  budgetMin    Float?
  budgetMax    Float?
  deliveryDate String?
  priority     String      @default("medium") // low | medium | high | urgent
  status       String      @default("draft")  // draft | published | quoted | ordered | completed | cancelled
  quotations   Quotation[]
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer     User        @relation(fields: [customerId], references: [id])
}

model RFQItem {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  rfqId         String  @db.ObjectId
  partNumber    String
  componentName String
  quantity      Int
  specifications String?
  notes         String?

  rfq           RFQ     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
}

model Quotation {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  rfqId         String          @db.ObjectId
  supplierId    String
  supplierName  String
  items         QuotationItem[]
  totalPrice    Float
  currency      String          @default("INR")
  leadTime      String
  validity      String
  deliveryTerms String
  paymentTerms  String
  attachments   String?         // JSON array
  status        String          @default("draft") // draft | sent | accepted | rejected | expired
  notes         String?
  expiresAt     DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  rfq           RFQ             @relation(fields: [rfqId], references: [id])
}

model QuotationItem {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  quotationId String    @db.ObjectId
  rfqItemId   String
  partNumber  String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  moq         Int?
  leadTime    String?

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

// ─── Community Forum ───────────────────────────────────────────────────────────

model ForumThread {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  authorId      String       @db.ObjectId
  authorName    String
  authorRole    String
  title         String
  content       String
  type          String       // requirement | question | discussion | recommendation
  tags          String       // JSON array
  images        String?      // JSON array
  specifications String?
  documents     String?      // JSON array
  replies       ForumReply[]
  views         Int          @default(0)
  likes         Int          @default(0)
  solved        Boolean      @default(false)
  bestAnswerId  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  author        User         @relation(fields: [authorId], references: [id])
}

model ForumReply {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  threadId     String      @db.ObjectId
  authorId     String      @db.ObjectId
  authorName   String
  authorRole   String
  content      String
  productLinks String?     // JSON array
  attachments  String?     // JSON array
  likes        Int         @default(0)
  helpful      Int         @default(0)
  isAnswer     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  thread       ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author       User        @relation(fields: [authorId], references: [id])
}

// ─── Cart ────────────────────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @unique @db.ObjectId
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  cartId           String  @db.ObjectId
  productId        String
  name             String
  price            Float
  quantity         Int
  image            String?
  brand            String?
  manufacturer     String?
  supplierName     String?
  minOrderQuantity Int     @default(1)
  stock            Int     @default(100)
  category         String?
  leadTime         String?
  packaging        String?

  cart             Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  customerId      String      @db.ObjectId
  supplierId      String
  items           OrderItem[]
  totalPrice      Float
  status          String      @default("pending") // pending | confirmed | shipped | delivered | cancelled
  deliveryAddress String      // JSON object
  trackingNumber  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deliveredAt     DateTime?

  customer        User        @relation(fields: [customerId], references: [id])
}

model OrderItem {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String  @db.ObjectId
  productId  String  @db.ObjectId
  quantity   Int
  unitPrice  Float
  totalPrice Float

  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
}
